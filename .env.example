# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=timora

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis (production) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── VAPID (Web Push) ─────────────────────────────────────────────────────────
# Generate with: python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@timora.app

# ── App ───────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_TITLE=Timora – Smart Reminder
APP_URL=http://localhost:8000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=timora@gmail.com
SMTP_PASSWORD=timora1234
SMTP_FROM_EMAIL=timora@gmail.com
SMTP_FROM_NAME=Timora
SMTP_USE_TLS=true

# Render blocks outbound SMTP on many web services. Use Resend over HTTPS in production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_API_URL=https://api.resend.com/emails